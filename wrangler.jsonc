{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "planning-poker",
  "main": "./worker/index.js",
  "compatibility_date": "2026-06-21",
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/room/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "PlanningRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PlanningRoom"]
    }
  ],
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "JOIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      // Automatic per-request logs include the full URL, and a room URL is a
      // join credential. Keep only the app's own structured events, which
      // reduce room ids to one-way tags.
      "invocation_logs": false
    }
  },
  // Staging environment: a separate Worker (planning-poker-staging) with its
  // own workers.dev URL and its own Durable Object storage, so staging rooms
  // never touch production data. Deploy with: wrangler deploy --env staging
  // Bindings (durable_objects, assets, ratelimits) are non-inheritable and
  // must be redefined here; main/compatibility_date/migrations/observability
  // inherit from the top level.
  "env": {
    "staging": {
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*", "/room/*"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "PlanningRoom"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "CREATE_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "JOIN_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 60,
            "period": 60
          }
        }
      ]
    }
  }
}
